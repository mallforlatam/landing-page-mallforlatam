# Ejemplo de variables de entorno para Vercel
# Añade estas variables en el Dashboard de Vercel (Project Settings > Environment Variables)

# URL pública del sitio (opcional, útil para enlaces absolutos)
NEXT_PUBLIC_SITE_URL=https://landing-page-mallforlatam.vercel.app

# Locale por defecto del sitio (opcional)
NEXT_PUBLIC_DEFAULT_LOCALE=es